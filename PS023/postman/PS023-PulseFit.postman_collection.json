{
  "info": {
    "name": "PS023 - PulseFit API",
    "description": "End-to-end Postman collection for the PulseFit PS023 microservices platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "memberId",
      "value": "1"
    },
    {
      "key": "planId",
      "value": "1"
    },
    {
      "key": "subscriptionId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "/api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.expect(pm.response.code).to.equal(200);",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demoUser\",\n  \"password\": \"demo123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 Members",
      "item": [
        {
          "name": "/api/members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members"
              ]
            }
          }
        },
        {
          "name": "/api/members/{{memberId}}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members",
                "{{memberId}}"
              ]
            }
          }
        },
        {
          "name": "/api/members",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Demo\",\n  \"email\": \"rahul.demo@pulsefit.com\",\n  \"phone\": \"9000000000\",\n  \"dateOfBirth\": \"2002-05-15\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 Subscriptions",
      "item": [
        {
          "name": "/api/subscriptions/plans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "plans"
              ]
            }
          }
        },
        {
          "name": "/api/subscriptions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": {{memberId}},\n  \"planId\": {{planId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('subscriptionId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/subscriptions/member/{{memberId}}/active",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/member/{{memberId}}/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "member",
                "{{memberId}}",
                "active"
              ]
            }
          }
        },
        {
          "name": "/api/subscriptions/{{subscriptionId}}/renew",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/renew",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "{{subscriptionId}}",
                "renew"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 Attendance",
      "item": [
        {
          "name": "/api/attendance/check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": {{memberId}},\n  \"facility\": \"Main Center\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "check-in"
              ]
            }
          }
        },
        {
          "name": "/api/attendance/member/{{memberId}}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/member/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "member",
                "{{memberId}}"
              ]
            }
          }
        },
        {
          "name": "/api/attendance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/attendance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05 Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        },
        {
          "name": "Eureka dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8761/",
              "host": [
                "http://localhost:8761"
              ],
              "path": []
            }
          }
        }
      ]
    }
  ]
}